# Get a free Parallel API key at https://platform.parallel.ai
PARALLEL_API_KEY=

# LLM provider API key — set the one matching your chosen provider.
# LiteLLM reads the standard env var for each provider automatically.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Get a Render API key at https://render.com/docs/api-keys
RENDER_API_KEY=

# Set after creating the Workflow service in the Render Dashboard
RENDER_WORKFLOW_SLUG=

# Secret for the Authorization: Bearer header.
# Generate one with: openssl rand -hex 32
# Leave empty for unauthenticated local dev.
API_SECRET=

# Optional overrides
# LLM_MODEL=anthropic/claude-sonnet-5       # default
# LLM_MODEL=openai/gpt-5                    # swap to OpenAI
# LLM_MODEL=bedrock/anthropic.claude-sonnet-5  # swap to Bedrock
# PLANNER_MODEL=anthropic/claude-haiku-4-5-20251001
# PARALLEL_SEARCH_MODE=fast
