# Get a free Parallel API key at https://platform.parallel.ai
PARALLEL_API_KEY=

# Get an Anthropic API key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get a Render API key at https://render.com/docs/api-keys
RENDER_API_KEY=

# Set after creating the Workflow service in the Render Dashboard
RENDER_WORKFLOW_SLUG=

# Secret for the Authorization: Bearer header.
# Generate one with: openssl rand -hex 32
# Leave empty for unauthenticated local dev.
API_SECRET=

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5
# PLANNER_MODEL=claude-haiku-4-5-20251001
# PARALLEL_SEARCH_MODE=fast
